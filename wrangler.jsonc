{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otf-website",
  "compatibility_date": "2026-07-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Where `esdev build` writes the pre-rendered site. Required by
    // `wrangler deploy`, which has no worker entrypoint to infer it from.
    "directory": "./dist",
    // Every route is prerendered to <path>/index.html and the sitemap and
    // canonicals name it without a trailing slash: serve /projects as it is
    // listed, rather than redirecting it to /projects/.
    "html_handling": "drop-trailing-slash",
    // An unknown URL answers 404 with dist/404.html, not a 200 copy of the
    // homepage that search engines would index as a duplicate.
    "not_found_handling": "404-page",
  },
  "compatibility_flags": ["nodejs_compat"]
}
